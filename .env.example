# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Analyst email(s) to notify — comma-separated for multiple recipients
ANALYST_EMAIL=analyst@example.com

# How often to check each target (minutes) — can be overridden per target
DEFAULT_CHECK_INTERVAL=15

# Flask secret key — change this to a random string.
# Left unset, a random key is generated at startup and logins end at restart.
SECRET_KEY=change-me-to-a-random-string

# ── Dashboard access ────────────────────────────────────────────────────────
# The dashboard always requires a password. Set one here, or leave both blank
# and Tripwire generates a single-run password and prints it to the log.
DASHBOARD_PASSWORD=your_password_here

# Preferred in production: store a hash instead of the password itself.
# Generate one with:  python3 auth.py
# DASHBOARD_PASSWORD_HASH=scrypt:32768:8:1$...

# Optional bearer token for scripted API calls:
#   curl -H "Authorization: Bearer $API_TOKEN" http://localhost:5500/api/targets
# API_TOKEN=

# How long a login lasts before it has to be repeated
SESSION_LIFETIME_DAYS=7

# Set both to 1 when Tripwire is served over HTTPS behind a proxy (e.g. Render)
SECURE_COOKIES=0
TRUST_PROXY=0

# Optional: session cookies for authenticated scraping
# Export cookies from your browser using "Get cookies.txt LOCALLY" (JSON format)
# TWITTER_COOKIES_FILE=/path/to/twitter_cookies.json
# LINKEDIN_COOKIES_FILE=/path/to/linkedin_cookies.json
