# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com

# Analyst email(s) to notify — comma-separated for multiple recipients
ANALYST_EMAIL=analyst@example.com

# How often to check each target (minutes) — can be overridden per target
DEFAULT_CHECK_INTERVAL=15

# Flask secret key — change this to a random string
SECRET_KEY=change-me-to-a-random-string

# Optional: path to Twitter/X session cookies JSON (for authenticated scraping)
# Export cookies from your browser using a tool like "Get cookies.txt LOCALLY"
# TWITTER_COOKIES_FILE=/path/to/twitter_cookies.json
